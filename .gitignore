# secrets. `.env*` covers .env, .env.local, .env.production and friends;
# `*.env` catches prod.env-style names too. Negation must come AFTER the
# broad patterns or git ignores it: env.example is a placeholder-only
# template and IS committed on purpose.
.env*
*.env
!env.example

# Anything a tool might drop a real credential into.
*.pem
*.key
secrets/
.envrc

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# node / next
node_modules/
.next/
out/
.vercel/
# tsc's incremental cache. It was committed by mistake in the initial commit
# and shows up as a spurious modification after every typecheck; untrack with
#   git rm --cached frontend/tsconfig.tsbuildinfo
tsconfig.tsbuildinfo

# misc
.DS_Store
*.log
.playwright-mcp/
# Tier 2 answer cache. Generated model output, keyed by config hash --
# regenerable, and it would churn the diff on every evaluation run.
.eval-cache/

# Generated by scripts/copyOrt.mjs from node_modules at build time: 14MB of
# onnxruntime-web's WASM, which is already pinned in package-lock.json.
# Anchored with the `frontend/` prefix -- a pattern containing a slash is
# relative to THIS file's directory, so a bare `public/ort/` matched nothing.
frontend/public/ort/
frontend/.mel-check/
