# Copy to .env:   Copy-Item env.example .env
# Then fill in every REPLACE_ME below. This file is committed, so it must never
# contain a real credential -- not even one you intend to rotate later.

# ---- Google AI Studio -------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey
# Free tier, no billing account required.
GOOGLE_API_KEY=REPLACE_ME

# Models are configured in the "--- models ---" section near the bottom of this
# file, and defaulted in config.py. Nothing needs to be set here.
#
# Re-check ids anytime: docker compose exec api python -m app.scripts.list_models

# Every structured step asks for generationConfig.responseSchema (strict JSON).
# Never use bare responseMimeType=application/json without a schema: it leaks
# chain-of-thought into the payload.
LLM_STRUCTURED_MODE=response_schema

# Token budget for the workhorse model. Gemini 3.5 Flash Lite allows 250K
# tokens/minute -- 15x Gemma's ~16K -- which is what made sending the whole
# transcript affordable. The limiter throttles to stay under it.
LLM_TOKENS_PER_MINUTE=250000
LLM_REQUESTS_PER_MINUTE=15

# ---- Web search (Serper) ----------------------------------------------------
# Optional. EMPTY = the web tool is not even declared to the model, so it
# cannot be called and the app behaves exactly as it did before web search
# existed. That is the whole point of gating on the key rather than on a flag:
# an unconfigured deploy can't half-work.
#
# Key from https://serper.dev (2,500 free queries, no card).
SERPER_API_KEY=
# WEB_SEARCH_RESULTS=5
# SERPER_REQUESTS_PER_MINUTE=60

# ---- File storage -----------------------------------------------------------
# Where the ORIGINAL uploads are kept. Without this the text is still indexed
# and every answer still works -- what you lose is re-chunking without
# re-uploading, and opening the actual page a citation points at.
#
# `local` writes to a Docker volume and is the default, deliberately: object
# storage should not stand between cloning this repo and seeing it work. It is
# also NOT enough for a deploy -- Render's free tier has no persistent disk, so
# a restart loses every file.
STORAGE_BACKEND=local
# STORAGE_DIR=/data/files

# Any S3-compatible store; the provider is just an endpoint.
#
#   Supabase       1GB, no card, and already a dependency here for auth
#                  https://<project>.supabase.co/storage/v1/s3
#   Cloudflare R2  10GB and zero egress, but requires a card
#                  https://<account>.r2.cloudflarestorage.com
#   Filebase       5GB, no card
#   MinIO          self-hosted
#
# Supabase: create a PRIVATE bucket, then Storage -> S3 -> New access key. The
# keys below are NOT your anon/service keys. Private matters -- the API checks
# ownership and mints 1-hour presigned URLs, whereas a public bucket is
# readable by anyone who guesses a UUID.
# STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# R2 ignores this; Supabase wants its project region.
# S3_REGION=auto
# Optional: a custom domain serving the bucket. Without one the API streams
# the bytes itself.
# S3_PUBLIC_BASE=

# ---- Embeddings -------------------------------------------------------------
# "gemini"    = Gemini Embedding via the key above (100 RPM / 1K req-per-day)
# "fastembed" = local ONNX BAAI/bge-small-en-v1.5 — no API, no quota, offline
EMBEDDING_PROVIDER=gemini
# Verified on this key: gemini-embedding-001, gemini-embedding-2,
# gemini-embedding-2-preview. All are natively 3072-dim.
EMBEDDING_MODEL=models/gemini-embedding-001
# Native is 3072, but outputDimensionality=768 is honoured and cuts Qdrant
# storage 4x with little recall loss. IMPORTANT: Google only L2-normalises the
# full 3072 vector, so any truncated output must be re-normalised client-side
# before it is stored, or cosine distance goes subtly wrong. The embedding
# provider does this. Changing this value means re-creating the Qdrant
# collection and re-ingesting -- collections are fixed-dimension.
EMBEDDING_DIM=768
# batchEmbedContents caps at 100 requests per call -- measured, 250 returns 400.
EMBEDDING_BATCH_SIZE=100
EMBEDDING_REQUESTS_PER_MINUTE=100
# TPM is the REAL bottleneck once batching is in place, not RPM or RPD:
# 100 chunks x ~225 tokens = ~22.5K tokens in ONE request, so 30K TPM allows
# only ~1.3 full batches/minute (~133 chunks/min). The limiter must count
# tokens, not just requests, or perfect batching still earns you 429s.
EMBEDDING_TOKENS_PER_MINUTE=30000

# ---- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---- Supabase auth ----------------------------------------------------------
# Leave BOTH blank to run with auth disabled: the app then behaves exactly as
# it did before auth existed -- one anonymous user, owner_id NULL, no
# filtering. Filling them in switches auth on with no migration.
#
# The BACKEND needs only the project URL. It verifies tokens against the public
# JWKS endpoint (measured: ES256, asymmetric), so it never holds a secret:
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://REPLACE_ME.supabase.co

# The publishable key (new-style; replaces the legacy `anon` key). Public by
# design -- it ships in the browser bundle and is safe there.
#
# NEVER put the `sb_secret_...` key in this file or anywhere in the frontend.
# The backend does not need it either: it verifies tokens against the public
# JWKS endpoint.
# Project Settings -> API Keys -> "publishable". Starts `sb_publishable_`.
SUPABASE_ANON_KEY=REPLACE_ME

# Only for legacy projects still signing with a shared HS256 secret. Projects
# created after 2025-05-01 use asymmetric keys and need nothing here.
# SUPABASE_JWT_SECRET=

# One-time migration switch for POST /auth/claim, which assigns rows with
# owner_id IS NULL to the caller. Already used once to adopt the corpus that
# predated auth. Keep it FALSE: left on, any new account could claim ownerless
# rows appearing later.
ALLOW_CLAIM_UNOWNED=false

# ---- Environment ------------------------------------------------------------
# "dev" or "prod". Controls anything that must differ in production; right now
# that is only whether /docs, /redoc and /openapi.json are served.
#
# config.py defaults this to "prod" deliberately -- a deployment that forgets
# to set it gets the RESTRICTIVE behaviour, not the permissive one. Local
# development gets APP_ENV=dev from docker-compose.yml.
APP_ENV=dev

# ---- Infra (docker compose overrides these; needed for bare-metal runs) -----
DATABASE_URL=postgresql+asyncpg://rd:rd_local_dev@localhost:5432/research_desk
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- observability (Langfuse) ---
#
# Empty = tracing OFF, and the app behaves exactly as it did before Langfuse
# existed. No keys, no failures, no noise.
#
# For the LOCAL stack you need none of these: docker-compose.yml defaults them
# to the headless-init keys it creates.
#
#     docker compose --profile obs up -d
#     open http://localhost:3001      (dev@example.com / localdev123)
#
# Set them only to point at Langfuse Cloud instead:
# LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
# LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- models ---
#
# Three models, split by free-tier REQUEST quota (which is per model), not by
# preference. Verified live on this key:
#
#   gemini-3.6-flash        5 rpm   schema ok, available     -> the answer
#   gemini-3.5-flash-lite  15 rpm   schema ok, available     -> plan/clarify/critique
#   gemma-4-26b            30 rpm   schema ok                -> query rewriting
#   gemini-3.8-flash        5 rpm   schema ok, 503 under load-> avoid
#   gemini-flash-latest     5 rpm   503 on every attempt     -> avoid
#   gemini-3.5-flash        5 rpm   VIOLATES responseSchema  -> unusable
#
# Defaults are in config.py; override only to change the split.
# LLM_MODEL=models/gemini-3.5-flash-lite
# ANSWER_MODEL=models/gemini-3.6-flash
# REWRITER_MODEL=models/gemma-4-26b-a4b-it
#
# Whole-transcript history. Gemini Flash reports a 1,048,576-token window, so
# the rolling summary is now a fallback rather than a requirement.
# HISTORY_FULL=true
# HISTORY_MAX_TOKENS=200000
#
# How many recent messages go through verbatim when the transcript DOES exceed
# the budget. Was 6 under the old token ceiling; 40 now that one is affordable.
# VERBATIM_MESSAGES=40

# --- ReAct (tool-calling retrieval) ---
#
# ON by default, because it is the only path that can route a question to
# where its answer lives. The planned path can only search the documents, so
# with it as the default the corpus becomes a hard boundary and anything the
# files do not cover comes back as "not in the provided documents" -- even
# when one web search would answer it.
#
# Documents and the web are peers here, not a primary and a fallback. Answers
# say which facts came from which, and everything is still cited: widening the
# sources does not license answering from memory.
#
# Set false to force the planned plan/retrieve/draft/critique path, which is
# what the evaluation harness measures. The UI exposes this per turn as
# "Research mode".
#
# Gemini emits real functionCall parts, which is what makes this possible at
# all -- Gemma narrated tool use as prose.
# REACT_DEFAULT=true
# REACT_MAX_ROUNDS=6
# REACT_MAX_CALLS_PER_ROUND=4
